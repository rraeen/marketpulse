# ============================================
# MarketPulse - Environment Variables Template
# ============================================

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/marketpulse
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# Authentication & Security
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=7d
MIN_PASSWORD_LENGTH=8

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="MarketPulse" <no-reply@marketpulse.com>
ENABLE_EMAIL_NOTIFICATIONS=true

# File Upload Configuration
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging & Monitoring
LOG_LEVEL=info

# Feature Flags (Phase 1)
ENABLE_USER_REGISTRATION=true
ENABLE_NOTIFICATIONS=true
ENABLE_SEARCH=true

# Admin Configuration
ADMIN_EMAIL=admin@marketpulse.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Admin User

# Security Headers & CORS
ALLOWED_ORIGINS=http://localhost:3000

# Performance & Caching
ENABLE_CACHE=false
CACHE_TTL=3600

# Testing Configuration
TEST_MONGODB_URI=mongodb://localhost:27017/marketpulse-test
TEST_JWT_SECRET=test-secret-key-for-testing-only

# Deployment & Infrastructure
BUILD_STANDALONE=true
HEALTH_CHECK_ENABLED=true
