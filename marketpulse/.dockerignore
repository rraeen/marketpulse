# ============================================
# MarketPulse - Docker Ignore File
# ============================================
# Excludes unnecessary files from Docker build context

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.*

# Testing
coverage
.nyc_output
test-results
playwright-report
.playwright
tests
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Next.js
.next
out

# Environment files (handled via build args/secrets)
.env*
!.env.example

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Documentation
*.md
!README.md

# CI/CD
.github

# Misc
.editorconfig
.eslintrc*
.prettierrc*
jest.config.*
playwright.config.*
tsconfig.json
